<div id="fejer-umap-root">
  <style>
    #fejer-umap-root{--background:#ffffff;--foreground:#171717;--border:#b8b8b8;--muted-foreground:#626262;--popover:#ffffff;--popover-foreground:#171717;--viz-series-1:#2563eb;--viz-series-2:#f59e0b;--viz-series-3:#22a06b;--viz-series-4:#dc4c3e;--viz-series-5:#8b5cf6;--viz-series-6:#0891b2;color:var(--foreground);background:var(--background);font:13px system-ui,sans-serif;padding:4px 2px 10px}
    @media(prefers-color-scheme:dark){#fejer-umap-root{--background:#181818;--foreground:#f2f2f2;--border:#666666;--muted-foreground:#b8b8b8;--popover:#242424;--popover-foreground:#f2f2f2;--viz-series-1:#60a5fa;--viz-series-2:#fbbf24;--viz-series-3:#4ade80;--viz-series-4:#f87171;--viz-series-5:#a78bfa;--viz-series-6:#22d3ee}}
    #fejer-umap-root .top{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin:0 0 8px}
    #fejer-umap-root h2{font-size:16px;margin:0;font-weight:650}
    #fejer-umap-root label{display:flex;align-items:center;gap:6px}
    #fejer-umap-root select{color:var(--foreground);background:var(--background);border:1px solid var(--border);padding:4px 6px}
    #fejer-umap-root svg{width:100%;height:auto;display:block}
    #fejer-umap-root .frame{fill:transparent;stroke:var(--border)}
    #fejer-umap-root .axis text,#fejer-umap-root .axis-title{fill:var(--foreground);font-size:12px}
    #fejer-umap-root .axis path,#fejer-umap-root .axis line{stroke:var(--border)}
    #fejer-umap-root circle{stroke:var(--background);stroke-width:.35;opacity:.78}
    #fejer-umap-root .status{margin-left:auto;color:var(--muted-foreground)}
    #fejer-umap-root .legend{display:flex;align-items:center;gap:8px;margin-top:5px;color:var(--muted-foreground)}
    #fejer-umap-root .ramp{width:160px;height:9px;background:linear-gradient(90deg,var(--viz-series-1),var(--viz-series-3),var(--viz-series-5))}
    #fejer-umap-root .tooltip{position:absolute;pointer-events:none;background:var(--popover);color:var(--popover-foreground);border:1px solid var(--border);padding:7px 9px;display:none;z-index:2;line-height:1.4}
    @media(max-width:420px){#fejer-umap-root .status{width:100%;margin-left:0}}
  </style>
  <div class="top"><h2>Historical Jicamarca covariate neighborhoods</h2><label>Color by <select id="fejer-color"><option value="r">SF99 residual</option><option value="f">F10.7</option><option value="t">Local time</option><option value="d">Season (day)</option><option value="s">SF99 background</option><option value="u">Measurement uncertainty</option><option value="c">Campaign</option></select></label><span class="status" id="fejer-status">Computing UMAP...</span></div>
  <svg role="img" aria-label="UMAP embedding of 1546 historical Jicamarca observations"></svg>
  <div class="legend"><span id="fejer-low"></span><span class="ramp"></span><span id="fejer-high"></span></div>
  <div class="tooltip" role="tooltip"></div>
  <script type="module">
    import * as d3 from "https://esm.sh/d3@7.9.0";
    import { UMAP } from "https://esm.sh/umap-js@1.3.3";
    const rows=__FEJER_DATA__;
    const root=document.getElementById("fejer-umap-root"), svg=d3.select(root.querySelector("svg")), tip=root.querySelector(".tooltip"), select=root.querySelector("select"), status=root.querySelector(".status");
    const mean=k=>d3.mean(rows,d=>d[k]), sd=k=>d3.deviation(rows,d=>d[k])||1, mf=mean("f"), sf=sd("f"), ms=mean("s"), ss=sd("s"), mu=mean("u"), su=sd("u");
    const input=rows.map(d=>{const lt=2*Math.PI*d.t/24, se=2*Math.PI*d.d/365.25;return[Math.sin(lt),Math.cos(lt),Math.sin(se),Math.cos(se),(d.f-mf)/sf,(d.s-ms)/ss,(d.u-mu)/su]});
    let seed=123456789; const random=()=>{seed|=0;seed=seed+0x6D2B79F5|0;let t=Math.imul(seed^seed>>>15,1|seed);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296};
    const umap=new UMAP({nComponents:2,nNeighbors:25,minDist:.18,nEpochs:350,random});
    const embedding=umap.fit(input); rows.forEach((d,i)=>{d.x=embedding[i][0];d.y=embedding[i][1]}); status.textContent="1,546 observations | inputs exclude VIPN residual";
    const css=getComputedStyle(root), series=[1,2,3,4,5,6].map(i=>css.getPropertyValue(`--viz-series-${i}`).trim()), campaigns=[...new Set(rows.map(d=>d.c))], categorical=d3.scaleOrdinal(campaigns,series);
    function draw(){const width=Math.max(360,root.clientWidth),height=Math.min(600,Math.max(390,width*.62)),m={t:12,r:20,b:48,l:64};svg.attr("viewBox",`0 0 ${width} ${height}`);svg.selectAll("*").remove();const x=d3.scaleLinear().domain(d3.extent(rows,d=>d.x)).nice().range([m.l,width-m.r]),y=d3.scaleLinear().domain(d3.extent(rows,d=>d.y)).nice().range([height-m.b,m.t]);svg.append("rect").attr("class","frame").attr("x",m.l).attr("y",m.t).attr("width",width-m.l-m.r).attr("height",height-m.t-m.b);svg.append("g").attr("class","axis").attr("transform",`translate(0,${height-m.b})`).call(d3.axisBottom(x).ticks(width<500?4:7));svg.append("g").attr("class","axis").attr("transform",`translate(${m.l},0)`).call(d3.axisLeft(y).ticks(6));svg.append("text").attr("class","axis-title").attr("data-axis","x").attr("x",(m.l+width-m.r)/2).attr("y",height-7).attr("text-anchor","middle").text("UMAP 1 (neighborhood coordinate)");svg.append("text").attr("class","axis-title").attr("data-axis","y").attr("transform",`translate(16,${(m.t+height-m.b)/2}) rotate(-90)`).attr("text-anchor","middle").text("UMAP 2 (neighborhood coordinate)");const k=select.value,vals=rows.map(d=>d[k]),extent=k==="c"?null:d3.extent(vals),ramp=d3.interpolateRgbBasis([series[0],series[2],series[4]]),color=k==="c"?d=>categorical(d.c):d=>ramp((d[k]-extent[0])/((extent[1]-extent[0])||1));root.querySelector(".legend").style.display=k==="c"?"none":"flex";if(extent){root.querySelector("#fejer-low").textContent=extent[0].toFixed(k==="u"?2:1);root.querySelector("#fejer-high").textContent=extent[1].toFixed(k==="u"?2:1)}svg.append("g").selectAll("circle").data(rows).join("circle").attr("cx",d=>x(d.x)).attr("cy",d=>y(d.y)).attr("r",width<500?2.3:2.8).attr("fill",color).on("pointerenter",(event,d)=>{tip.style.display="block";tip.innerHTML=`Campaign ${d.c}<br>LT ${d.t.toFixed(2)} h | day ${d.d} | F10.7 ${d.f.toFixed(1)}<br>VIPN ${d.o.toFixed(2)} | SF99 ${d.s.toFixed(2)} | residual ${d.r.toFixed(2)} m/s`;}).on("pointermove",event=>{const box=root.getBoundingClientRect();tip.style.left=`${event.clientX-box.left+12}px`;tip.style.top=`${event.clientY-box.top+12}px`}).on("pointerleave",()=>tip.style.display="none")}
    select.addEventListener("change",draw);new ResizeObserver(draw).observe(root);draw();
  </script>
</div>
